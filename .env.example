# Copy to .env and fill in. .env is gitignored and is never logged or printed.
# DEMO CREDENTIALS ONLY. Do not put a live account in here.

# --- MT5 terminal -----------------------------------------------------------
# Path to the terminal64.exe this bot should drive. Point it at the SECOND
# MT5 installation, not the one the other bots use — a terminal can only be
# logged into one account at a time, and whoever calls initialize(login=...)
# last wins. That contention is what broke mt5_beast_bot.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 Gold26\terminal64.exe

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Telegram ---------------------------------------------------------------
# Missing values disable alerts with a warning. They never block trading:
# a dead notification channel is not a reason to stop managing open risk.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Live trading unlocks ---------------------------------------------------
# Both are required before a single live order can be sent, and there is no
# code path that bypasses them. These are the account owner's to set.
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=
